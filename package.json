{
  "name": "paste-safe",
  "version": "1.0.0",
  "description": "Sanitize secrets and PII from your clipboard before you paste logs into AI chats or GitHub issues.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "paste-safe": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "security",
    "secrets",
    "pii",
    "clipboard",
    "redaction",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lordporus/paste-safe.git"
  },
  "homepage": "https://github.com/Lordporus/paste-safe#readme",
  "bugs": {
    "url": "https://github.com/Lordporus/paste-safe/issues"
  },
  "author": "Lordporus",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
